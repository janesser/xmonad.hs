# Restart syndaemon when touchpad device appears or disappears
# Device: HS-CH12U-PTP-01-04-14 USB KeyBoard Touchpad
# This handles detach/reattach and suspend/resume

ACTION=="add|remove", SUBSYSTEM=="input", ATTR{name}=="HS-CH12U-PTP-01-04-14 USB KeyBoard Touchpad", RUN+="/usr/local/bin/restart-syndaemon"
