#!/bin/bash

if [ ! -t 0 ]; then
    echo "⚠️  No interactive terminal — cannot ask for consent."
    echo "   Aborting; re-run under an interactive cz apply."
    exit 1
fi

echo "This will install apt keyrings/sources under /etc."

read -r -p "Continue? [y/N] " answer || true
case "${answer}" in
    [Yy]|[Yy][Ee][Ss]) : ;;
    *) echo "Aborted (no confirmation)."; exit 0 ;;
esac

if [ "$CHEZMOI_ARCH" = "amd64" ]; then
    cd $CHEZMOI_SOURCE_DIR
    sudo install -d -m 0755 -o root -g root /etc/apt/keyrings
    sudo install -d -m 0755 -o root -g root /etc/apt/sources.list.d
    sudo install -m 0644 -o root -g root -t /etc/apt/keyrings ./etc/apt/keyrings/*
    sudo install -m 0644 -o root -g root -t /etc/apt/sources.list.d ./etc/apt/sources.list.d/*
else
    echo $CHEZMOI_ARCH not supported for additional apt sources.
fi

sudo apt install -y extrepo
