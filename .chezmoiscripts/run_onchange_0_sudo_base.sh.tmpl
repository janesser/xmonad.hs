#!/bin/bash
# run_onchange_0_sudo_base.sh.tmpl
#
# Install the sudoers drop-in that every box in the fleet carries: `base`. It
# grants the constructive commands used by `cz update` plus the two cleanup
# wrappers, which require a password on every invocation.
#
#   source: etc/sudoers.d/base          (NOT applied by chezmoi; etc/ is ignored)
#   target: /etc/sudoers.d/base         (root:root, mode 0440)

set -euo pipefail

DEST=/etc/sudoers.d/base
SRC="${CHEZMOI_SOURCE_DIR:-.}/etc/sudoers.d/base"

if [ ! -f "${SRC}" ]; then
    echo "⚠️  Source sudoers file not found: ${SRC}"
    exit 1
fi

# Idempotent (backstop): already installed and unchanged -> nothing to do.
if [ -f "${DEST}" ] && sudo cmp -s "${SRC}" "${DEST}"; then
    echo "✅ ${DEST} already installed and up to date. Nothing to do."
    exit 0
fi

# Consent gate: never prompt without a TTY (fail closed for unattended runs).
if [ ! -t 0 ]; then
    echo "⚠️  No interactive terminal — cannot ask for consent."
    echo "   Install manually:"
    echo "     sudo install -o root -g root -m 0440 etc/sudoers.d/base /etc/sudoers.d/base"
    echo "     sudo visudo -cf /etc/sudoers.d/base"
    exit 1
fi

echo "Installing the common sudoers drop-in: ${DEST}"
read -r -p "Continue? [y/N] " answer || true
case "${answer}" in
    [Yy]|[Yy][Ee][Ss]) : ;;
    *) echo "Aborted (no confirmation)."; exit 0 ;;
esac

sudo install -o root -g root -m 0440 "${SRC}" "${DEST}"
sudo visudo -cf "${DEST}"

echo "✅ ${DEST} installed and validated."
echo "Verify with: sudo -l"
