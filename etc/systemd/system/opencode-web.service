# Installed by
# .chezmoiscripts/run_once_5_aitools_8opencode.sh
# to /etc/systemd/system/opencode-web.service

# OpenCode AI coding agent web UI, exposed on the LAN. Runs standalone (a
# foreground process tracked by systemd — the pattern opencode's docs recommend
# for always-on hosts) rather than opencode's shared background service, so the
# model backends (:8081/:8082) stay behind it and are never bound to the LAN.
#
# Listen on every network interface (0.0.0.0), default port 49374 (opencode's
# Linux default). Clients connect with:
#
#   http://cyberkleiber:49374            # browser web UI, via opencode pair
#   opencode --server http://127.0.0.1:49374  # TUI connected to the same server
#
# No secrets live in this unit (the generated server password is printed by
# `opencode serve` and lives in its logs).

[Unit]
Description=OpenCode AI coding agent web UI (:49374, LAN)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jan
Group=jan
Environment=HOME=/home/jan
Environment=USER=jan
Environment=PATH=/home/jan/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/jan/.local/share/mise/installs/node/latest/bin/opencode serve --hostname 0.0.0.0 --port 49374
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
