# /etc/sudoers.d/chezmoi-pi-camera-debug
# pi-agent: passwordless sudo ONLY for the chuwi_ubook_xpro camera debug stack.
# SEPARATE from chezmoi-pi by design (auditable; won't collide with chezmoi's
# file ownership). Review + validate with:
#   visudo -cf /etc/sudoers.d/chezmoi-pi-camera-debug
# Install (after explicit user consent), as root:
#   install -m 0440 /path/to/chezmoi-pi-camera-debug /etc/sudoers.d/chezmoi-pi-camera-debug
#
# Stock IPU3/CIO2 + int3472 discrete-PMIC debug only:
#   modprobe / rmmod   load/unload ov5648, ov2680 (and reload after a DSDT patch)
#   i2cdetect/i2cset/i2cget/i2ctransfer  probe the PMIC GPIO/register config
#   media-ctl          enable /dev/media links (requires root: media dev is root-only)
#   acpidump           dump DSDT/SSDT from /sys/firmware (requires root)
#   v4l2-ctl / iasl    verify capture / recompile a patched DSDT
Cmnd_Alias CAMERA_DEBUG = \
    /usr/sbin/modprobe, \
    /usr/sbin/rmmod, \
    /usr/sbin/i2cdetect, \
    /usr/sbin/i2cset, \
    /usr/sbin/i2cget, \
    /usr/sbin/i2ctransfer, \
    /usr/bin/media-ctl, \
    /usr/bin/acpidump, \
    /usr/bin/iasl, \
    /usr/bin/v4l2-ctl

# Camera EC / SCC power investigation (READ-ONLY).
# The boot EC on this machine is PORT-mapped (0x66/0x62, GPE 0x50), so ec_sys
# does NOT create /dev/ec_sys. Read the kernel's shadow of EC memory via debugfs:
#   /sys/kernel/debug/ec/<ec>/{read_only,write_only,read_write}  -> region bounds
#   /sys/kernel/debug/ec/<ec>/os                                 -> OS-writable EC mem
#   /sys/kernel/debug/ec/<ec>/bios                               -> EC firmware region
# All root:root 0600; ec/ dir is 0700 root. Read-only = safe/reversible.
# (Writing camera power to the port EC needs iopl(3) on 0x62/0x63 — custom root
#  binary, kept strictly last. Not granted here.)
Cmnd_Alias CAMERA_EC_DEBUG = \
    /usr/bin/ls /sys/kernel/debug/ec/*, \
    /usr/bin/cat  /sys/kernel/debug/ec/*, \
    /usr/bin/od   -A x -t x1z /sys/kernel/debug/ec/*, \
    /usr/bin/xxd  /sys/kernel/debug/ec/*

# --- grant to this user only ---
jan ALL=(root) NOPASSWD: CAMERA_DEBUG
jan ALL=(root) NOPASSWD: CAMERA_EC_DEBUG
