# Installed by
# .chezmoiscripts/run_once_5_aitools_2llama_startup.sh
# to /etc/systemd/system/restart-llama-server.service
#
# Runs jan's ~/.local/bin/restart-llama-server.sh at system boot, BEFORE any
# login. This is a *system* unit (not a user unit): only a system unit starts
# at boot without a logged-in session, so no `loginctl enable-linger` is
# required.
#
# The huggingface-hub bind-mount onto ~/.cache/huggingface/hub is added to
# /etc/fstab by the same run script, so at boot the hub is already a
# mountpoint and the script's `if ! mountpoint …` branch is skipped — meaning
# the script never needs `sudo mount` (which has no password here) at boot.

[Unit]
Description=Restart llama.cpp server via ~/.local/bin/restart-llama-server.sh
# Wait for filesystems (incl. the passeport automount), the NVIDIA persistence
# daemon, and the NVIDIA kernel driver to be ready.
#
# Ordering after nvidia-persistenced alone is NOT enough: that userspace daemon
# starts at the same time as this unit, well before the kernel driver finishes
# initializing (the boot race that made the CUDA probe fail). Adding
# sys-bus-pci-drivers-nvidia.device orders after the nvidia driver binds the PCI
# GPU, which is the real "driver ready" signal. Wants= keeps the daemon optional
# without hard-failing boot if it is absent.
After=local-fs.target media-passeport.mount nvidia-persistenced.service sys-bus-pci-drivers-nvidia.device
Wants=nvidia-persistenced.service

[Service]
User=jan
Environment=HOME=/home/jan
Environment=USER=jan
Environment=PATH=/home/jan/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Fail fast: refuse to start (and let systemd abort the unit) unless a CUDA
# device is available. Without this, llama.cpp auto-mode silently falls back to
# CPU when VRAM is unusable, loads the ~26 GB model into system RAM and OOMs.
#
# Retry a few times: even with the driver ordered above, the CUDA userspace
# backend needs a moment to initialize after the driver binds. A short local
# loop avoids depending on systemd's 30s RestartSec to recover the probe.
ExecStartPre=/usr/bin/bash -c 'for i in $(seq 1 8); do if llama serve --list-devices 2>/dev/null | grep -q CUDA; then exit 0; fi; echo "restart-llama-server: CUDA not ready, attempt $${i}/8, retrying..." >&2; sleep 2; done; echo "restart-llama-server: no CUDA device after 8 attempts, refusing to fall back to CPU" >&2; exit 1'
# The script forks `llama serve` in the background and exits itself.
ExecStart=/usr/bin/fish /home/jan/.local/bin/restart-llama-server.sh
Type=oneshot
RemainAfterExit=yes
# Only the launcher (fish) is tracked; leave the orphaned llama server running
# when the oneshot launcher exits / the service is stopped.
KillMode=process
KillSignal=SIGTERM
TimeoutStartSec=120s
# Self-heal: if the unit fails (OOM, or the CUDA probe above), retry after a
# short delay so the service comes back once CUDA/VRAM is available again
# instead of requiring a manual restart.
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
