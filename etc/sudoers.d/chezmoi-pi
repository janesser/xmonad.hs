# /etc/sudoers.d/chezmoi-pi
# pi-agent: passwordless sudo ONLY for commands chezmoi (cz update) needs.
# Managed by design story. Review + validate with:
#   visudo -cf /etc/sudoers.d/chezmoi-pi
# Source copy lives in this repo under etc/sudoers.d/ (NOT applied by chezmoi:
# etc/ is in .chezmoiignore). It is installed, with explicit user consent, by
# .chezmoiscripts/run_9_0_sudoers_chezmoi_pi.sh as part of cz update.
# NOTE: do NOT add `Defaults !requiretty` here. `requiretty` was removed from
# sudo (1.9.x); listing it makes visudo treat the file as invalid and breaks
# sudo entirely. Modern sudo no longer requires a tty for these rules.
#
# `journalctl` is allowed so `cz apply` can compact the systemd journal
# (run_9_cleanup_journalctl.sh) without a TTY. It only touches /var/log/journal,
# which is root:systemd-journal 0750, so the rule is scoped to that binary only
# (any args) — no shell/file-write access.

# The setcap line lets btop surface Intel Iris Xe GPU usage: btop reads the
# i915 GPU perf PMU (perf_event_open), which needs CAP_PERFMON. It is an EXACT
# match (sudoers forbids intra-arg wildcards) — only the one call made by
# .chezmoiscripts/run_once_5_aitools_3btop_intel_gpu_cap.sh is authorized, and
# only on /usr/bin/btop. Guarded there by has_intel_gpu() so ARM / NVIDIA-only /
# headless boxes never get it. See that script's header for the full story.

# --- package / repo / service / group / family writes (any args) ---
Cmnd_Alias CHEZMOI_PKGS = \
    /usr/bin/apt, \
    /usr/bin/add-apt-repository, \
    /usr/bin/nala, \
    /usr/bin/snap, \
    /usr/sbin/usermod, \
    /usr/sbin/groupadd, \
    /usr/bin/update-alternatives, \
    /usr/bin/mkdir, \
    /usr/bin/chmod, \
    /usr/bin/chown, \
    /usr/bin/tee, \
    /usr/bin/cp, \
    /usr/bin/gpg, \
    /usr/bin/mv, \
    /usr/bin/sed, \
    /usr/bin/extrepo, \
    /usr/bin/dpkg, \
    /usr/bin/curl, \
    /usr/bin/rm, \
    /usr/bin/install, \
    /usr/bin/cmp, \
    /usr/sbin/setcap cap_perfmon+ep /usr/bin/btop, \
    /usr/bin/journalctl, \
    /home/jan/.local/share/chezmoi/uninstaller/ollama_uninstall.sh \

# --- scoped systemctl: unit-management subcommands only -----------------------
# Replaces the previous bare `/usr/bin/systemctl` (any args). Each line mirrors a
# form actually used by the chezmoi run_* scripts (see run_once_5_aitools_*,
# run_once_3_podman_nvidia_cdi, run_onchange_auto_poweroff_timer). `enable *`,
# `disable *`, `restart *` also match their trailing flags (--now, --user, ...)
# because a bare `*` swallows the rest of the args; `--system *` / `--user *`
# cover the bus-qualified forms. This lets `systemctl restart llama-sycl` work
# while forbidding broader `systemctl` abuse (set-environment, daemon-reexec,
# import, load, etc.). No shell / file-write access is granted.
Cmnd_Alias SYSTEMCTL_UNIT = \
    /usr/bin/systemctl daemon-reload, \
    /usr/bin/systemctl enable *, \
    /usr/bin/systemctl disable *, \
    /usr/bin/systemctl start *, \
    /usr/bin/systemctl stop *, \
    /usr/bin/systemctl restart *, \
    /usr/bin/systemctl status *, \
    /usr/bin/systemctl is-active *, \
    /usr/bin/systemctl is-enabled *, \
    /usr/bin/systemctl list-unit-files *, \
    /usr/bin/systemctl --system *, \
    /usr/bin/systemctl --user * \

# --- grant to this user only ---
jan ALL=(root) NOPASSWD: CHEZMOI_PKGS, SYSTEMCTL_UNIT
