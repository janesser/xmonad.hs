#!/bin/bash
# run_onchange_sudo_sudoers_chezmoi_pi_omarchy.sh.tmpl
#
# Install the scoped sudoers drop-in that lets pi-agent run `sudo omarchy update`
# passwordlessly on omarchy boxes (see AGENTS.md for the sudo boundary).
#
#   source: etc/sudoers.d/chezmoi-omarchy   (NOT applied by chezmoi; etc/ is ignored)
#   target: /etc/sudoers.d/chezmoi-omarchy   (root:root, mode 0440)
#
# --- chezmoi change filter (run only when the SOURCE file changes) -------------
# This is a `run_onchange_` template. The SHA256 of the sudoers source file is
# embedded below as a comment, so the *rendered* script changes whenever the
# source file changes. Chezmoi hashes the rendered script and only runs THIS
# script when that hash changes. When the source is unchanged, chezmoi skips the
# script entirely — no `sudo cmp`, no prompt — on every `chezmoi apply`.
#
#   chezmoi-omarchy source hash: {{ include "etc/sudoers.d/chezmoi-omarchy" | sha256sum }}
# ------------------------------------------------------------------------------
#
# Idempotent (backstop): only writes when the installed file is missing or differs.
# Consent : asks for a yes/no confirmation before writing anything under /etc.

set -euo pipefail

DEST=/etc/sudoers.d/chezmoi-omarchy
SRC="${CHEZMOI_SOURCE_DIR:-.}/etc/sudoers.d/chezmoi-omarchy"

# --- guard: omarchy boxes only ---
# `omarchy` does not exist on other boxes: the drop-in would be invalid there, so
# skip silently instead of failing `cz apply`.
if ! command -v omarchy >/dev/null; then
    echo "===> sudoers: no omarchy found (not an omarchy box) — skipping"
    exit 0
fi

if [ ! -f "${SRC}" ]; then
    echo "⚠️  Source sudoers file not found: ${SRC}"
    echo "   Create it, then run cz update again."
    exit 1
fi

# Idempotent backstop: already installed and unchanged -> nothing to do.
if [ -f "${DEST}" ] && sudo cmp -s "${SRC}" "${DEST}"; then
    echo "✅ ${DEST} already installed and up to date. Nothing to do."
    exit 0
fi

# Consent gate: never prompt without a TTY (fail closed for unattended runs).
if [ ! -t 0 ]; then
    echo "⚠️  No interactive terminal — cannot ask for consent."
    echo "   Install manually:"
    echo "     sudo install -o root -g root -m 0440 etc/sudoers.d/chezmoi-omarchy /etc/sudoers.d/chezmoi-omarchy"
    echo "     sudo visudo -cf /etc/sudoers.d/chezmoi-omarchy"
    exit 1
fi

echo "Installing a passwordless-sudo drop-in for `omarchy update`."

# --- install the drop-in (root:root, mode 0440) -------------------------------
sudo install -o root -g root -m 0440 "${SRC}" "${DEST}" || exit $?
sudo visudo -cf "${DEST}" || exit $?

echo "✅ ${DEST} installed."
