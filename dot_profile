#!/usr/bin/env bash

# ~/.profile: executed by the command interpreter for login shells.
# This file is not read by bash(1), if ~/.bash_profile or ~/.bash_login
# exists.
# see /usr/share/doc/bash/examples/startup-files for examples.
# the files are located in the bash-doc package.

# the default umask is set in /etc/profile; for setting the umask
# for ssh logins, install and configure the libpam-umask package.
#umask 022

killall -q clamfs || echo "No Running clamfs."
# don't disturb xserver start
clamfs ~/.config/clamfs.d/downloads.xml 2>/dev/null >/dev/null


# if running bash
if [ -n "$BASH_VERSION" ]; then
    # include .bashrc if it exists
    if [ -f "$HOME/.bashrc" ]; then
        . "$HOME/.bashrc"
    fi
fi

# set PATH so it includes user's private bin if it exists
if [ -d "$HOME/bin" ]; then
    PATH="$HOME/bin:$PATH"
fi

# set PATH so it includes user's private bin if it exists
if [ -d "$HOME/.local/bin" ]; then
    PATH="$HOME/.local/bin:$PATH"
fi

if [ -d "$HOME/go/bin" ]; then
    PATH="$HOME/go/bin:$PATH"
fi

if [ -d "$HOME/.ghcup/bin" ]; then
    PATH="$HOME/.ghcup/bin:$PATH"
fi

if [ -d "$HOME/.cargo/bin" ]; then
    PATH="$HOME/.cargo/bin:$PATH"
fi

if [ -d "$HOME/.venv/bin" ]; then
    PATH="$HOME/.venv/bin:$PATH"
fi

if [ -d "$HOME/.local/share/flatpak/exports/bin" ]; then
    PATH="$HOME/.local/share/flatpak/exports/bin:$PATH"
fi

# mise shims are handled by ~/.config/fish/conf.d/mise.fish (interactive) and
# mise activate in scripts; no static asdf-shims line needed anymore.

export PATH=$PATH

export EDITOR=hx

if command -v rustup; then
    rustup default stable 2>&1
fi

if [ -n "$SSH_AUTH_SOCK" ]; then
    echo ssh-agent via forwaring $SSH_AUTH_SOCK
else
    export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR}/ssh-agent.socket"
fi


export GTK_THEME=Adwaita:dark
