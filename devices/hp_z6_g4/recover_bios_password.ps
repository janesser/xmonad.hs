<#
.SYNOPSIS
    Brute-force BIOS password validator.

.DESCRIPTION
    Iterates through password combinations and validates them using a specified command.
    Supports resumable runs via a state file.

.PARAMETER CharSet
    The set of characters to use for password generation.
.PARAMETER MinLength
    Minimum password length.
.PARAMETER MaxLength
    Maximum password length.
.PARAMETER Command
    The command to execute (e.g., 'BIOSConfigUtil64.exe /GetConfig /cspassfile:temp_pass.txt').
.PARAMETER RefusingString
    The string that indicates a password attempt was rejected.
.PARAMETER StateFile
    The path to the file used to store the last attempted password for resumability.
#>

param (
    [Parameter(Mandatory=$false)]
    [string]$CharSet = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789",

    [Parameter(Mandatory=$false)]
    [int]$MinLength = 4,

    [Parameter(Mandatory=$false)]
    [int]$MaxLength = 8,

    [Parameter(Mandatory=$false)]
    [string]$Command = "BIOSConfigUtil64.exe /GetConfig /cspassfile:temp_pass.txt",

    [Parameter(Mandatory=$false)]
    [string]$RefusingString = "Invalid password",

    [Parameter(Mandatory=$false)]
    [string]$StateFile = ".bios_brute_state"
)

# --- Internal Helpers ---

function Get-NextPassword {
    param (
        [string]$CurrentPassword,
        [string]$Charset,
        [int]$TargetLength
    )

    $chars = $Charset.ToCharArray()
    $len = $CurrentPassword.Length
    if ($len -eq 0) {
        return $chars[0]
    }

    $pwdArr = $CurrentPassword.ToCharArray()
    
    # Find the last character that can be incremented
    $idx = $len - 1
    while ($idx -ge 0) {
        $currentCh = $pwdArr[$idx]
        $charIdx = [array]::IndexOf($chars, $currentCh)
        if ($charIdx -lt $chars.Length - 1) {
            $pwdArr[$idx] = $chars[$charIdx + 1]
            # Reset subsequent characters
            for ($i = $idx + 1; $i -lt $len; $i++) {
                $pwdArr[$i] = $chars[0]
            }
            return -join $pwdArr
        }
        $idx--
    }

    return $null # Exhausted this length
}

# --- Main Logic ---

# 1. Load State
$lastTried = ""
if (Test-Path $StateFile) {
    $lastTried = (Get-Content $StateFile -Raw).Trim()
    Write-Host "[*] Resuming from last state: '$lastTried'" -ForegroundColor Cyan
}

# 2. Iterate Lengths
for ($len = $MinLength; $len -le $MaxLength; $len++) {
    Write-Host "[*] Testing length: $len" -ForegroundColor Gray
    
    $attempt = ""
    
    # Handle Resumption Logic
    if ($lastTried.Length -eq $len) {
        # We need to start testing from the password AFTER $lastTried
        $attempt = Get-NextPassword -CurrentPassword $lastTried -Charset $CharSet -TargetLength $len
        if ($null -eq $attempt) {
            # Already finished this length in a previous run
            continue
        }
    } elseif ($lastTried.Length -gt $len) {
        # lastTried belongs to a later length, so this length is already done
        continue
    } else {
        # Start from the first possible for this length
        $chars = $CharSet.ToCharArray()
        $attempt = -join (& { for ($i=1; $i -le $len; $i++) { $chars[0] })
    }

    while ($attempt -ne $null -and $attempt -ne "") {
        $pwd = $attempt
        
        # Update state BEFORE attempting to ensure progress is recorded
        $pwd | Out-File $StateFile -Encoding utf8
        
        Write-Host "[>] Trying: $pwd" -NoNewline
        
        # 3. Execute Command
        $tempFile = "temp_pass.txt"
        $pwd | Out-File $tempFile -Encoding utf8
        
        try {
            $output = Invoke-Expression $Command 2>&1
            $outputString = $output | Out-String
            
            Write-Host " [OK]" -ForegroundColor Green

            # 4. Check Result
            if (-not ($outputString -match $RefusingString)) {
                Write-Host "`n[!] SUCCESSFUL PASSWORD FOUND: $pwd" -ForegroundColor Green -BackgroundColor Black
                Write-Host "----------------------------------------"
                $pwd | Out-File "successful_password.txt"
                if (Test-Path $tempFile) { Remove-Item $tempFile -ErrorAction SilentlyContinue }
                if (Test-Path $StateFile) { Remove-Item $StateFile -ErrorAction SilentlyContinue }
                exit 0
            }
        }
        catch {
            Write-Host " [!]" -ForegroundColor Yellow
            Write-Warning "Command error: $($_.Exception.Message)"
        }
        finally {
            if (Test-Path $tempFile) { Remove-Item $tempFile -ErrorAction SilentlyContinue }
        }

        # Move to next combination
        $attempt = Get-NextPassword -CurrentPassword $pwd -Charset $CharSet -TargetLength $len
    }
}

Write-Host "`n[i] Exhausted all combinations without success." -ForegroundColor Yellow
