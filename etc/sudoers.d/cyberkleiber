# /etc/sudoers.d/cyberkleiber
# sudoers drop-in for cyberkleiber (= hp_z6_g4, memory hub and ai-server).
# Grants the card2-swap tool's `systemd-run` command: `--detach` runs the image
# batch as a transient root unit (`systemd-run --unit=card2-image-<ts> ...`), so
# this is the broadest line in the file — it can create arbitrary transient root
# units. Sole intended consumer: /home/jan/.local/bin/card2-swap.sh (manual tool).
# Remove this drop-in when card2-swap.sh is retired.

Cmnd_Alias CARD2_SWAP = \
    /usr/bin/systemd-run \

jan ALL=(root) NOPASSWD: CARD2_SWAP
