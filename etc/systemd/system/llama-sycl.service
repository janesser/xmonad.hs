# Installed by
# .chezmoiscripts/run_once_5_aitools_2llama_startup.sh (dual-backend deploy,
# one backend table manages both llama-cuda and llama-sycl) to
# /etc/systemd/system/llama-sycl.service
#
# Runs llama.cpp on the Intel GPU (SYCL / oneAPI) in ROUTER mode, serving every
# SYCL model discovered from the bind-mounted HF cache on 127.0.0.1:8082 so
# Olla can proxy it publicly on :8082. Mirrors llama-cuda.service (the CUDA
# backend on :8081) but for the Intel accelerator: same Type=oneshot launcher
# pattern, same --device pin, same journalctl logging.
#
# NOTE: enabled at boot, but left to an explicit `systemctl start` (this unit
# is START=no in the backend table) because loading a model into the Iris Xe
# shared-memory budget is heavy and the SYCL build itself is a one-time
# bootstrap. See the launcher's memory guard and ExecStartPre below.
#
# The huggingface-hub bind-mount onto ~/.cache/huggingface/hub is added to
# /etc/fstab by run_once_5_aitools_2llama_startup.sh, so at boot the hub is
# already a mountpoint.

[Unit]
Description=llama.cpp on Intel GPU (SYCL) — router mode, 127.0.0.1:8082
After=local-fs.target media-passeport.mount

[Service]
User=jan
Environment=HOME=/home/jan
Environment=USER=jan
Environment=PATH=/home/jan/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/jan/.local/share/mise/shims
# The launcher DETACHES llama-server (fork + disown) and exits, so systemd runs
# it as Type=oneshot: the launcher is the only tracked process, and once it
# exits the unit becomes active(exited) while the orphaned llama-server keeps
# serving. KillMode=process + KillSignal=SIGTERM means `systemctl stop/restart`
# kills only the already-exited launcher, leaving the orphan running; the
# launcher reaps the previous orphan on the next run (see the script).
#
# Self-heal: if the launcher itself fails, retry after a short delay instead of
# requiring a manual restart. NOTE: unlike Type=simple, systemd does NOT restart
# a llama-server that dies while running — the unit is already "done" at that
# point. This is the CUDA backend's trade-off (mirrors restart-llama-cuda).
Type=oneshot
RemainAfterExit=yes
# Fail fast rather than silently falling back to CPU. Probe for a live SYCL
# device (needs the oneAPI runtime on LD_LIBRARY_PATH to enumerate); retry a
# few times for the runtime init race. If the SYCL build was never bootstrapped,
# skip cleanly (exit 0) so a fresh boot does not fail-loop — the launcher will
# build it on first explicit start.
ExecStartPre=/usr/bin/bash -c 'if [ ! -x "$HOME/projs/llama.cpp/build_sycl/bin/llama" ]; then echo "llama-sycl: SYCL build not present — bootstrap first (run ~/.local/bin/restart-llama-sycl.sh)" >&2; exit 0; fi; . "$HOME/.local/share/llama-cpp/lib.sh"; . "$ONEAPI_SETVARS" >/dev/null 2>&1 || true; for i in $(seq 1 8); do if "$BUILD_SYCL/bin/llama" serve --list-devices 2>/dev/null | grep -q SYCL; then exit 0; fi; echo "llama-sycl: SYCL not ready, attempt $${i}/8, retrying..." >&2; sleep 2; done; echo "llama-sycl: no SYCL device after 8 attempts, refusing to fall back to CPU" >&2; exit 1'
ExecStart=/usr/bin/bash /home/jan/.local/bin/restart-llama-sycl.sh live 8082
KillMode=process
KillSignal=SIGTERM
TimeoutStartSec=120s
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
