#!/bin/bash
# run_onchange_sudo_sudoers_chezmoi_pi_pacman.sh.tmpl
#
# Install the scoped sudoers drop-in that lets pi-agent run `sudo pacman`
# passwordlessly on pacman-based boxes (omarchy).
#
#   source: etc/sudoers.d/chezmoi-pi-pacman   (NOT applied by chezmoi; etc/ is ignored)
#   target: /etc/sudoers.d/chezmoi-pi-pacman   (root:root, mode 0440)
#
# --- chezmoi change filter (run only when the SOURCE file changes) -------------
# This is a `run_onchange_` template. The SHA256 of the sudoers source file is
# embedded below as a comment, so the *rendered* script changes whenever the
# source file changes. Chezmoi hashes the rendered script and only runs THIS
# script when that hash changes. When the source is unchanged, chezmoi skips the
# script entirely — no `sudo cmp`, no prompt — on every `chezmoi apply`.
#
#   chezmoi-pi-pacman source hash: {{ include "etc/sudoers.d/chezmoi-pi-pacman" | sha256sum }}
# ------------------------------------------------------------------------------
#
# Idempotent (backstop): only writes when the installed file is missing or differs.
# Consent : asks for a yes/no confirmation before writing anything under /etc.

set -euo pipefail

DEST=/etc/sudoers.d/chezmoi-pi-pacman
SRC="${CHEZMOI_SOURCE_DIR:-.}/etc/sudoers.d/chezmoi-pi-pacman"

# --- guard: pacman-based boxes only ---
# `pacman` does not exist on apt boxes: the pacman drop-in would be invalid
# there, so skip silently instead of failing `cz apply`.
if ! command -v pacman >/dev/null; then
    echo "==> sudoers: no pacman found (not a pacman box) — skipping"
    exit 0
fi

if [ ! -f "${SRC}" ]; then
    echo "⚠️  Source sudoers file not found: ${SRC}"
    echo "   Create it, then run cz update again."
    exit 1
fi

# Idempotent backstop: already installed and unchanged -> nothing to do.
if [ -f "${DEST}" ] && sudo cmp -s "${SRC}" "${DEST}"; then
    echo "✅ ${DEST} already installed and up to date. Nothing to do."
    exit 0
fi

# Consent gate: never prompt without a TTY (fail closed for unattended runs).
if [ ! -t 0 ]; then
    echo "⚠️  No interactive terminal — cannot ask for consent."
    echo "   Install manually:"
    echo "     sudo install -o root -g root -m 0440 etc/sudoers.d/chezmoi-pi-pacman /etc/sudoers.d/chezmoi-pi-pacman"
    echo "     sudo visudo -cf /etc/sudoers.d/chezmoi-pi-pacman"
    exit 1
fi

echo "Installing a passwordless-sudo drop-in scoped to pacman commands."
echo "  source: ${SRC}"
echo "  target: ${DEST}  (root:root, mode 0440)"
read -r -p "Continue? [y/N] " answer || true
case "${answer}" in
    [Yy]|[Yy][Ee][Ss]) : ;;
    *) echo "Aborted (no confirmation)."; exit 0 ;;
esac

sudo install -o root -g root -m 0440 "${SRC}" "${DEST}"
sudo visudo -cf "${DEST}"

echo "✅ ${DEST} installed and validated."
echo "Verify with: sudo -l"
