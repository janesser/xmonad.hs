# /etc/sudoers.d/chezmoi-pi
# pi-agent: passwordless sudo ONLY for commands chezmoi (cz update) needs on
# apt/nala/snap boxes.
#
# Managed by design story. Review + validate with:
#   visudo -cf /etc/sudoers.d/chezmoi-pi
# Source copy lives in this repo under etc/sudoers.d/ (NOT applied by chezmoi:
# etc/ is in .chezmoiignore). It is installed, with explicit user consent, by
# .chezmoiscripts/run_onchange_sudo_sudoers_chezmoi_pi.sh.tmpl as part of
# cz update.
# NOTE: do NOT add `Defaults !requiretty` here. `requiretty` was removed from
# sudo (1.9.x); listing it makes visudo treat the file as invalid and breaks
# sudo entirely. Modern sudo no longer requires a tty for these rules.
#
# Cross-cutting commands (journalctl, systemctl, the file-write commands,
# visudo) live in `chezmoi-pi-common` and are installed on every box. This
# drop-in keeps only what an apt box can use.

# --- apt package / repo / service / group / family writes (any args) ---------
Cmnd_Alias CHEZMOI_PKGS = \
    /usr/bin/apt, \
    /usr/bin/add-apt-repository, \
    /usr/bin/nala, \
    /usr/bin/snap, \
    /usr/bin/update-alternatives, \
    /usr/bin/extrepo, \
    /usr/sbin/setcap cap_perfmon+ep /usr/bin/btop \

# --- podman: rootful container engine (apt boxes only) ----------------------
# run_once_3_devtools_3podman.sh installs podman rootful (/run/podman is
# root:docker, socket 0660), so `podman system prune` needs root — granted
# here because podman only exists on apt boxes.
Cmnd_Alias CHEZMOI_PODMAN = \
    /usr/bin/podman \
    /usr/bin/podman-compose \

# --- scoped systemd-run: card-2 swap self-detach -----------------------------
# jan-approved 2026-10-23 (card-2 little-brother design; see
# discoveries/ai-server/little-brother-card2-swap.md): card2-swap.sh --detach
# registers its stop-batch-restore sequence as a transient root unit
# (`systemd-run --unit=card2-image-<ts> ...`). The grant is ANY ARGS — the
# command the unit executes cannot be pinned without flag-order brittleness —
# so this is the broadest line in the file (it can create arbitrary transient
# root units). Sole intended consumer: /home/jan/.local/bin/card2-swap.sh.
# Remove this alias and the grant below when card2-swap.sh is retired.
Cmnd_Alias SYSTEMD_RUN_CARD2 = \
    /usr/bin/systemd-run \

# --- grant to this user only ---
jan ALL=(root) NOPASSWD: CHEZMOI_PKGS, CHEZMOI_PODMAN, SYSTEMD_RUN_CARD2
