#!/bin/bash
# run_onchange_1_sudo_apt.sh.tmpl
#
# Install the sudoers drop-in for the ubuntu-rooted boxes (lincopta, raspberrypi,
# cyberkleiber): `apt`. Grants the package families plus what rootful containers
# need on these boxes. Not installed on pacman boxes — that's flowerpower's job.
#
# inputs hash: {{ print (include "etc/sudoers.d/apt") | sha256sum }}

set -euo pipefail

DEST=/etc/sudoers.d/apt
SRC="${CHEZMOI_SOURCE_DIR:-.}/etc/sudoers.d/apt"

command -v apt || exit 0

if [ ! -f "${SRC}" ]; then
    echo "⚠️  Source sudoers file not found: ${SRC}"
    exit 1
fi

# Idempotent (backstop): already installed and unchanged -> nothing to do.
if [ -f "${DEST}" ] && sudo cmp -s "${SRC}" "${DEST}"; then
    echo "✅ ${DEST} already installed and up to date. Nothing to do."
    exit 0
fi

# Consent gate: never prompt without a TTY (fail closed for unattended runs).
if [ ! -t 0 ]; then
    echo "⚠️  No interactive terminal — cannot ask for consent."
    echo "   Install manually:"
    echo "     sudo install -o root -g root -m 0440 etc/sudoers.d/apt /etc/sudoers.d/apt"
    echo "     sudo visudo -cf /etc/sudoers.d/apt"
    exit 1
fi

echo "Installing the ubuntu-rooted package family drop-in: ${DEST}"
read -r -p "Continue? [y/N] " answer || true
case "${answer}" in
    [Yy]|[Yy][Ee][Ss]) : ;;
    *) echo "Aborted (no confirmation)."; exit 0 ;;
esac

sudo install -o root -g root -m 0440 "${SRC}" "${DEST}"
sudo visudo -cf "${DEST}"

echo "✅ ${DEST} installed and validated."
echo "Verify with: sudo -l"
