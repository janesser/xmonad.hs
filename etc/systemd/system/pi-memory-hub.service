# Installed by
# .chezmoiscripts/run_once_5_aitools_7pi_memory_hub.sh
# to /etc/systemd/system/pi-memory-hub.service
#
# pi-hermes-memory v2 shared memory hub (spine AD-2/AD-14). Runs as a *system*
# unit so it starts at boot without a login (same pattern as the llama units).
# It is a SEPARATE service from the AI backend (AD-2): its own lifecycle and
# its own port (8083) — llama-cuda handovers never darken shared memory.
#
# The hub code is a checkout of jan's pi-hermes-memory fork under
# ~/.local/share/pi-hermes-memory/hub-src, provisioned by the run script. The
# unit execs a launcher that runs the checkout's local tsx (the codebase uses
# .js-suffixed TypeScript imports and has no build step).
#
# Secrets are NOT in this unit or in the repo (AD-5/AD-14): the token store
# and TLS material live under ~/.local/share/pi-hermes-memory/hub/ (local-only,
# generated by the run script). The unit carries no tokens or keys.

[Unit]
Description=pi-hermes-memory shared memory hub (TLS :8083)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=jan
Group=jan
Environment=HOME=/home/jan
Environment=USER=jan
Environment=PATH=/home/jan/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PI_MEMORY_HUB_HOST=0.0.0.0
Environment=PI_MEMORY_HUB_PORT=8083
Environment=PI_MEMORY_HUB_DIR=/home/jan/.local/share/pi-hermes-memory/hub
Environment=PI_MEMORY_HUB_CERT=/home/jan/.local/share/pi-hermes-memory/hub/tls/hub.crt
Environment=PI_MEMORY_HUB_KEY=/home/jan/.local/share/pi-hermes-memory/hub/tls/hub.key
Environment=PI_MEMORY_HUB_CA=/home/jan/.local/share/pi-hermes-memory/hub/tls/ca.crt
Environment=PI_MEMORY_HUB_DB=/home/jan/.local/share/pi-hermes-memory/hub/shared.sqlite
Environment=PI_MEMORY_HUB_TOKENS=/home/jan/.local/share/pi-hermes-memory/hub/tokens.json
ExecStart=/home/jan/.local/bin/pi-memory-hub-serve.sh
# Self-heal: if the hub crashes (bad checkout, OOM), retry after a short delay.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
