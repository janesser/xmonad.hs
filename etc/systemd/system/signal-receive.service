# Installed by
# .chezmoiscripts/run_once_5_aitools_8signal_pi.sh
# to /etc/systemd/system/signal-receive.service
#
# The signal-cli daemon (native mode, provisioned by the @aalzubidy/pi-signal
# extension's setup wizard on this box). Runs in single-account mode and exposes
# JSON-RPC + an in-memory SSE endpoint for incoming messages, bound to all
# interfaces so every pi-agent instance in the fleet can reach it over LAN.
#
# One account runs on one host only: moving `~/.local/share/signal-cli/data`
# (the key material) requires stopping the old instance first, or the SQLite DBs
# conflict and both desync/duplicate messages.

[Unit]
Description=Signal message receiver for pi (signal-cli on raspberrypi)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jan
ExecStart=/usr/local/bin/signal-receive-loop.sh
Restart=always
RestartSec=15
TimeoutStopSec=15
Environment=HOME=/home/jan
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PI_SIGNAL_ACCOUNT=+4917620128275
Environment=PI_SIGNAL_QUIET_DAEMON=true

[Install]
WantedBy=multi-user.target
