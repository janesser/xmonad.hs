# Installed by
# .chezmoiscripts/run_once_5_aitools_8b_opencode_pi.sh
# to /etc/systemd/system/opencode-pi.service
#
# OpenCode AI coding agent web UI, exposed on the LAN. Runs standalone (a
# foreground process tracked by systemd — the pattern opencode's docs recommend
# for always-on hosts) rather than opencode's shared background service. The Pi
# has no GPU, so this serves as a thin terminal: model calls are routed to
# cyberkleiber's backends (:8081/:8082), which are reachable from the LAN over
# port 8081/8082. The opencode config (dot_config/opencode/opencode.json)
# already points at those ports, so this box is only a terminal.
#
# Listen on every network interface (0.0.0.0), default port 49374 (opencode's
# Linux default). Clients connect with:
#
#   http://raspberrypi:49374            # browser web UI, via opencode pair
#   opencode --server http://raspberrypi:49374  # TUI connected to the same server
#
# No secrets live in this unit (the generated server password is printed by
# `opencode serve` and lives in its logs).

[Unit]
Description=OpenCode AI coding agent web UI (:49374, LAN) — raspberrypi
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jan
Group=jan
Environment=HOME=/home/jan
Environment=USER=jan
Environment=PATH=/home/jan/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/jan/.local/bin/opencode serve --hostname 0.0.0.0 --port 49374
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
