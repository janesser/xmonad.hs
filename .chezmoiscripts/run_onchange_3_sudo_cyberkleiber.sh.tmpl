#!/bin/bash
# run_onchange_3_sudo_cyberkleiber.sh.tmpl
#
# Install the sudoers drop-in for cyberkleiber (= hp_z6_g4, memory hub and
# ai-server): `systemd-run` for card2-swap's transient root units.
#
# inputs hash: {{ print (include "etc/sudoers.d/cyberkleiber") | sha256sum }}

set -euo pipefail

DEST=/etc/sudoers.d/cyberkleiber
SRC="${CHEZMOI_SOURCE_DIR:-.}/etc/sudoers.d/cyberkleiber"

[ "$(hostname)" = "cyberkleiber" ] || exit 0

if [ ! -f "${SRC}" ]; then
    echo "⚠️  Source sudoers file not found: ${SRC}"
    exit 1
fi

# Idempotent (backstop): already installed and unchanged -> nothing to do.
if [ -f "${DEST}" ] && sudo cmp -s "${SRC}" "${DEST}"; then
    echo "✅ ${DEST} already installed and up to date. Nothing to do."
    exit 0
fi

# Consent gate: never prompt without a TTY (fail closed for unattended runs).
if [ ! -t 0 ]; then
    echo "⚠️  No interactive terminal — cannot ask for consent."
    echo "   Install manually:"
    echo "     sudo install -o root -g root -m 0440 etc/sudoers.d/cyberkleiber /etc/sudoers.d/cyberkleiber"
    echo "     sudo visudo -cf /etc/sudoers.d/cyberkleiber"
    exit 1
fi

echo "Installing the cyberkleiber drop-in: ${DEST}"
read -r -p "Continue? [y/N] " answer || true
case "${answer}" in
    [Yy]|[Yy][Ee][Ss]) : ;;
    *) echo "Aborted (no confirmation)."; exit 0 ;;
esac

sudo install -o root -g root -m 0440 "${SRC}" "${DEST}"
sudo visudo -cf "${DEST}"

echo "✅ ${DEST} installed and validated."
echo "Verify with: sudo -l"
